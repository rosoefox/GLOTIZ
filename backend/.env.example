# 이 파일을 복사해서 .env로 만들고 값을 채우세요: cp .env.example .env
# .env 자체는 git에 안 올라가므로(.gitignore), 새로 clone하면 이 파일만 참고할 수 있습니다.

VERTEX_AI_PROJECT_ID=team-01-504502
# GCP 콘솔 > IAM > 서비스 계정에서 marketing-image-gen 계정 키(JSON)를 새로 발급받아
# 이 backend 폴더에 넣고, 그 파일 경로를 적으세요. (키 파일 자체는 절대 git에 커밋 금지)
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\team-01-504502-XXXXXXXX.json
DOCUMENT_AI_PROCESSOR_ID=383e6d38cff8ac0d
CLOUD_SQL_HOST=34.31.141.53
CLOUD_SQL_DB=jbxport
CLOUD_SQL_USER=postgres
# CLOUD_SQL_PASSWORD, AUTH_JWT_SECRET는 여기 안 적습니다 - Secret Manager
# (jbxport-cloud-sql-password, jbxport-auth-jwt-secret)에서 앱이 직접 읽어옵니다.
# 위 GOOGLE_APPLICATION_CREDENTIALS 서비스 계정에 "Secret Manager 보안 비밀 접근자"
# 권한만 있으면 별도 설정 없이 자동으로 됩니다.
GCS_TEMPLATES_BUCKET=team-01-504502-templates
GCS_GENERATED_BUCKET=team-01-504502-generated
# 파인튜닝된 필드판단 모델 엔드포인트. 없으면 base gemini-2.5-flash로 자동 폴백됩니다.
TUNED_BLANK_CANDIDATE_MODEL=projects/639709983318/locations/us-central1/endpoints/3220324971976851456
